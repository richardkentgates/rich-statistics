#!/usr/bin/env bash
# rsa-deploy-cron — runs every minute, checks for deploy trigger file
# Install: sudo crontab -e → add: * * * * * /usr/local/bin/rsa-deploy-cron
set -euo pipefail

TRIGGER="/var/www/rs-app/.deploy-trigger"
LOG="/var/log/rsa-deploy.log"

if [ ! -f "$TRIGGER" ]; then
    exit 0
fi

AGE=$(( $(date +%s) - $(stat -c %Y "$TRIGGER") ))
if [ "$AGE" -gt 120 ]; then
    rm -f "$TRIGGER"
    exit 0
fi

rm -f "$TRIGGER"

echo "$(date -u +%FT%TZ)  Trigger received — running update…" >> "$LOG"
/usr/local/bin/rsa-app-update >> "$LOG" 2>&1
echo "$(date -u +%FT%TZ)  Update complete." >> "$LOG"
