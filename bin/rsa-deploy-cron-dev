#!/usr/bin/env bash
# rsa-deploy-cron-dev — runs every minute, checks for dev deploy trigger file
set -euo pipefail

TRIGGER="/var/www/rs-app-dev/.deploy-trigger"
LOG="/var/log/rsa-deploy-dev.log"

if [ ! -f "$TRIGGER" ]; then
    exit 0
fi

AGE=$(( $(date +%s) - $(stat -c %Y "$TRIGGER") ))
if [ "$AGE" -gt 120 ]; then
    rm -f "$TRIGGER"
    exit 0
fi

rm -f "$TRIGGER"

echo "$(date -u +%FT%TZ)  DEV trigger received — running update…" >> "$LOG"
/usr/local/bin/rsa-app-update-dev >> "$LOG" 2>&1
echo "$(date -u +%FT%TZ)  DEV update complete." >> "$LOG"
