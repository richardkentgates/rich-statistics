#: build/stage/rich-statistics/includes/class-admin.php:1270
#: includes/class-admin.php:1136
msgid "Getting Started with Rich Statistics"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1271
msgid "Once activated, navigate to Analytics in the admin sidebar to view your data. The dashboard starts collecting pageviews immediately — no configuration required."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1272
#: includes/class-admin.php:1138
msgid "Key Settings:"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1274
msgid "Data retention: Analytics → Preferences → Data Retention"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1275
msgid "Bot filtering sensitivity: Analytics → Preferences → Tracking"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1276
msgid "Email digests: Analytics → Preferences → Email Reports"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1277
msgid "App access: Analytics → Preferences → App Access"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1278
msgid "Multisite: Network Admin → Rich Statistics for cross-site overview and AI"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1280
msgid "Premium features (click tracking, heatmaps, WooCommerce, REST API) are available via the Upgrade link in the admin sidebar."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1288
#: includes/class-admin.php:1154
msgid "Privacy"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1290
#: includes/class-admin.php:1156
msgid "Privacy by Design"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1291
#: includes/class-admin.php:1157
msgid "Rich Statistics does not store personally identifiable information. Sessions are identified by a UUID stored in sessionStorage (not cookies) that is cleared when the browser tab closes. IP addresses are never stored. Referrer URLs are truncated to domain only."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1292
#: includes/class-admin.php:1158
msgid "If a visitor's browser has Do Not Track (DNT) or Global Privacy Control (GPC) enabled, the tracker exits immediately — no session is created and no data is sent."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1293
#: includes/class-admin.php:1159
msgid "Because no PII is collected, most sites using Rich Statistics do not require a cookie consent banner for the analytics data collected by this plugin. Always consult a qualified lawyer for advice specific to your situation."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1303
#: includes/class-admin.php:1169
msgid "Overview Dashboard"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1304
#: includes/class-admin.php:1170
msgid "The overview shows your total pageviews, unique sessions, average time on page, and bounce rate for the selected period. The daily chart lets you spot traffic trends at a glance."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1305
#: includes/class-admin.php:1171
msgid "Use the period selector (top right) to switch between Last 7 days, Last 30 days, Last 90 days, This month, and Last month."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1306
#: includes/class-admin.php:1172
msgid "Bounce rate"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1306
#: includes/class-admin.php:1172
msgid "is calculated as the percentage of sessions that viewed only a single page."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1312
#: build/stage/rich-statistics/templates/admin/overview.php:176
#: includes/class-admin.php:1178
#: templates/admin/overview.php:178
msgid "Top Pages"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1313
#: includes/class-admin.php:1179
msgid "This view ranks every page on your site by the number of pageviews in the selected period. The average time on page is shown for each URL."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1314
#: includes/class-admin.php:1180
msgid "Page paths are stored after stripping query parameters that appear to contain personal data (email-shaped values or strings longer than 40 characters)."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1320
#: includes/class-admin.php:1186
msgid "Audience Breakdown"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1321
#: includes/class-admin.php:1187
msgid "Operating system, browser name, browser version, viewport size, language, and timezone are detected from the browser environment using JavaScript and stored as non-identifying aggregate categories."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1322
msgid "Viewport buckets: Mobile (≤480px), Tablet (481–1024px), Desktop (>1024px)."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1323
#: includes/class-admin.php:1189
msgid "Language codes follow the BCP 47 standard as reported by navigator.language (e.g. en-US, fr-FR, de)."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1329
#: includes/class-admin.php:1195
msgid "Referrer Tracking"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1330
#: includes/class-admin.php:1196
msgid "Only the referring domain is stored — never the full URL. This prevents leaking of personal data that might appear in referrer URLs (e.g. search queries, email campaign tokens)."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1331
#: includes/class-admin.php:1197
msgid "Direct traffic, bookmark visits, and traffic from HTTPS sites to your HTTP site appear as \"(direct)\" because browsers do not send a Referer header in these cases."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1337
#: includes/class-admin.php:1203
msgid "UTM Campaign Tracking"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1338
#: includes/class-admin.php:1204
msgid "Campaigns are tracked automatically when visitors land on your site with UTM parameters in the URL (utm_source, utm_medium, utm_campaign). The values are captured from the landing-page URL and attributed to every pageview in that browser session."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1339
#: includes/class-admin.php:1205
msgid "Use the Medium filter to isolate traffic from a specific channel (e.g. email, cpc, social)."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1345
#: includes/class-admin.php:1211
msgid "Behavior Analysis"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1346
#: includes/class-admin.php:1212
msgid "Time on page is measured using the Visibility API — the timer pauses when the visitor switches tabs and resumes when they return. The value is sent when the page is closed via the Beacon API."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1347
#: includes/class-admin.php:1213
msgid "Session depth shows how many pages most visitors view in a single session. Entry pages lists the pages where most sessions start."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1353
#: includes/class-admin.php:1219
msgid "User Flow Analysis"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1354
#: includes/class-admin.php:1220
msgid "The Path Explorer shows page-to-page navigation in Miller columns. Each column is one step in the journey — click any page to drill forward and see where visitors went next. A drop-off funnel above the columns shows how many sessions reached each step."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1355
#: includes/class-admin.php:1221
msgid "Percentages in each column are relative to the selected page in the previous column, so they reflect \"of visitors who reached this page, N% continued to…\". Switch to the Journey Table view to browse every recorded page pair with counts and percentages."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1359
#: build/stage/rich-statistics/includes/class-admin.php:1361
#: includes/class-admin.php:1225
#: includes/class-admin.php:1227
msgid "Click Tracking (Premium)"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1362
#: includes/class-admin.php:1228
msgid "Click tracking captures non-navigational interactions: phone links (tel:), email links (mailto:), map links (geo:), SMS links (sms:), and file downloads. HTTP/HTTPS link navigation is tracked automatically as pageviews. You can add additional element IDs and CSS classes in Preferences."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1363
#: includes/class-admin.php:1229
msgid "The Destination column shows the actual value supplied to the protocol handler: the phone number for tel: links, the email address for mailto: links, the coordinates for geo: links, the SMS number for sms: links, and the file path or URL for downloads."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1364
#: includes/class-admin.php:1230
msgid "Click tracking uses event delegation — no inline event handlers are added to the page."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1368
#: build/stage/rich-statistics/includes/class-admin.php:1370
#: includes/class-admin.php:1234
#: includes/class-admin.php:1236
msgid "Heatmap (Premium)"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1371
#: includes/class-admin.php:1237
msgid "The heatmap displays a dark canvas showing scroll-depth guide lines and click-hotspot dots for any tracked page. Dot colour ranges from cool blue (few clicks) to hot red (many clicks). Hover a dot to see which DOM elements were clicked at that position. Coordinates are stored as viewport-relative percentages so the heatmap works at any screen size."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1372
#: includes/class-admin.php:1238
msgid "The side panel lists the top-clicked elements with a click bar chart — useful for identifying links and buttons that get the most engagement."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1373
#: includes/class-admin.php:1239
msgid "Use the Period selector to change the date range. Custom start/end dates are supported. Raw click coordinates are aggregated into a 2% grid nightly by a background cron task to keep storage efficient."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1377
#: build/stage/rich-statistics/includes/class-admin.php:1379
#: includes/class-admin.php:1243
#: includes/class-admin.php:1245
msgid "WooCommerce Analytics (Premium)"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1380
#: includes/class-admin.php:1246
msgid "Automatically tracks product views, add-to-cart events (standard and AJAX), and order completions. Surfaces a conversion funnel, top products table, and a revenue-over-time chart."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1381
#: includes/class-admin.php:1247
msgid "No customer data is stored — events are linked to anonymous session IDs only. Order totals are recorded in the store currency but no customer name, address, or email is retained."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1382
#: includes/class-admin.php:1248
msgid "WooCommerce tracking can be toggled on or off from Rich Statistics → Preferences."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1386
#: includes/class-admin.php:1252
msgid "Export (Premium)"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1388
#: includes/class-admin.php:1254
msgid "CSV Export (Premium)"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1389
#: includes/class-admin.php:1255
msgid "Download raw events, sessions, or click data as a CSV file for any date range you choose. Use it with spreadsheet software, R, Python, or any business intelligence tool."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1390
#: includes/class-admin.php:1256
msgid "Exports are generated on demand — they are not cached. Large date ranges on high-traffic sites may take a moment to compile."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1397
#: build/stage/rich-statistics/templates/admin/preferences.php:29
#: includes/class-admin.php:1263
#: templates/admin/preferences.php:31
msgid "Bot score threshold"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1397
#: includes/class-admin.php:1263
msgid "Requests scoring at or above this value are silently discarded as automated traffic. Range: 1–10. Default: 5. Lower values filter more aggressively."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1398
#: includes/class-admin.php:1264
msgid "Data retention"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1398
#: includes/class-admin.php:1264
msgid "Events older than the retention period are pruned nightly. Range: 1–730 days. Default: 90 days. Disable pruning to keep all data indefinitely."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1399
#: includes/class-admin.php:1265
msgid "Email digests"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1399
#: includes/class-admin.php:1265
msgid "Configure a periodic summary email (daily, weekly, or monthly). Sent via wp_mail — no third-party email service required. Enter comma-separated addresses for multiple recipients."
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1400
#: includes/class-admin.php:1266
msgid "Insights panel"
msgstr ""

#: build/stage/rich-statistics/includes/class-admin.php:1400
#: includes/class-admin.php:1266
msgid "The Overview page now includes a free Insights section derived directly from your analytics data. No LLM or API key needed — insight cards are computed server-side from your metrics. For conversational AI, use the Rich Statistics PWA with your own AI provider configured in the app's settings."
msgstr ""

